#!/usr/bin/make -f

# Keep Go's build cache inside the package build tree rather than
# touching $HOME (which may not exist/be writable in a clean build
# chroot). GOFLAGS=-mod=mod lets the go command fetch/update go.mod and
# go.sum itself as needed rather than failing closed on any mismatch --
# this build does need module-proxy network access as a result (CI's
# runner has it; a fully offline/air-gapped build would need to switch
# this to -mod=readonly against a pre-populated go.sum instead).
export GOCACHE := $(CURDIR)/debian/.gocache
export GOFLAGS := -mod=mod
export GO111MODULE := on
# cgo against libjpeg-turbo (see internal/snapshot) for JPEG encoding --
# needed to sustain 30fps on native-resolution MJPEG tiers, which the
# standard library's pure-Go image/jpeg couldn't. CI builds natively on
# real arm64 hardware (see .github/workflows/build.yml), so this needs no
# C cross-compiler there. A genuine cross-arch build (foreign
# DEB_HOST_ARCH below) would additionally need a C cross-compiler plus
# target-arch libturbojpeg0-dev and a PKG_CONFIG_LIBDIR pointed at its
# multiarch .pc files (same shape as picam-raw/debian/rules' cmake cross
# setup) -- not wired up here since nothing currently exercises that path.
export CGO_ENABLED := 1

DEB_BUILD_ARCH := $(shell dpkg-architecture -qDEB_BUILD_ARCH)
DEB_HOST_ARCH  := $(shell dpkg-architecture -qDEB_HOST_ARCH)
CROSS_COMPILING := $(filter-out $(DEB_BUILD_ARCH),$(DEB_HOST_ARCH))

ifneq ($(CROSS_COMPILING),)
export GOOS   := linux
export GOARCH := $(subst aarch64,arm64,$(shell dpkg-architecture -qDEB_HOST_GNU_CPU))
endif

%:
	dh $@

override_dh_auto_build:
	go build -trimpath -o picam-orchestrator ./cmd/picam-orchestrator

override_dh_auto_test:
ifeq ($(CROSS_COMPILING),)
	go vet ./...
	go test ./internal/luxswitch/... ./internal/discovery/... ./internal/uistate/... ./internal/irlight/... ./internal/recorder/... ./internal/snapshot/...
else
	# Cross-compiling with CGO_ENABLED=1 and no C cross-compiler
	# configured (see the CGO_ENABLED comment above) -- go vet will
	# still try to invoke cgo for internal/snapshot here and fail
	# without one. This branch was only ever exercised by a foreign
	# DEB_HOST_ARCH build, which this repo's own CI doesn't do (it
	# builds natively on arm64 hardware); left as-is since fixing it
	# means standing up the cross C toolchain this plan deliberately
	# didn't wire up.
	go vet ./...
endif

override_dh_auto_install:
	install -D -m 0755 picam-orchestrator debian/picam-orchestrator/usr/bin/picam-orchestrator
	install -D -m 0644 config.ini debian/picam-orchestrator/etc/picam-orchestrator/config.ini

override_dh_installsystemd:
	dh_installsystemd --no-restart-on-upgrade --no-stop-on-upgrade

override_dh_dwz:
	# dwz deduplicates DWARF debug info across multiple binaries in a
	# package; this package ships exactly one, and dwz doesn't
	# understand the DWARF layout Go's own linker produces anyway
	# (fails with "Found compressed .debug_aranges section, not
	# attempting dwz compression"). Skip it rather than work around it.

override_dh_auto_clean:
	dh_auto_clean
	rm -f picam-orchestrator
	rm -rf debian/.gocache
